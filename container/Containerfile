# Image shared by every per-worktree agent container.
# Built by orca-box as localhost/orca-agents:latest (orca-box-setup --update to refresh).
FROM docker.io/library/node:24-bookworm

# The agent image needs: git, ripgrep, fd, jq, python, a compiler for
# native npm packages, and the GitHub CLI.
#
# The GitHub CLI comes from the official repository the GitHub CLI
# maintainers publish, not from a tarball. That matters for portability:
# apt picks the package matching the machine's architecture, so the same
# Containerfile works on amd64 and arm64 with nothing to detect and no
# per-architecture checksums to keep up to date. The keyring below is the
# trust anchor -- its checksum is the one GitHub publishes at
# https://cli.github.com/packages -- and apt checks the repository's
# signature against it.
#
# Debian calls find-in-files "fdfind"; the agents ask for "fd", so that is
# linked too.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      git ripgrep fd-find jq python3 python3-venv build-essential ca-certificates curl less; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg; \
    echo "6084d5d7bd8e288441e0e94fc6275570895da18e6751f70f057485dc2d1a811b  /etc/apt/keyrings/githubcli-archive-keyring.gpg" | sha256sum -c -; \
    echo "deb [signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh; \
    rm -rf /var/lib/apt/lists/*; \
    ln -sf /usr/bin/fdfind /usr/local/bin/fd

# Claude Code, Codex and pi, installed system-wide so the shared $HOME volume
# doesn't hide them. Rebuild the image to update (auto-updaters can't write here).
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
 && npm install -g @anthropic-ai/claude-code @openai/codex \
 && npm cache clean --force

# The browser.
#
# Some skills look at the page they are working on: they screenshot it,
# or drive it with a headless browser. So the image has a browser in it.
#
# Chromium comes from Debian, so apt picks the package for the machine's
# architecture and brings the shared libraries with it -- libnspr4 and
# the rest. Those libraries are why a browser that was put into an image
# by hand cannot start: it is there, but half of it is not.
#
# The libraries the Playwright build of Chromium needs are listed here
# as well, because it is not the Debian package: same browser, built by
# somebody else. Playwright's own "install --with-deps" is not used: it
# only knows the distributions it has been told about, and this image is
# a base image that moves.
#
# The fonts are here for the same reason: a page with no font in it is a
# page of boxes, and a screenshot of that tells nobody anything. The
# Chinese font is a large one, but a page of Chinese text that is all
# boxes is worse.
#
# Set ORCA_BOX_BROWSER=0 to build the image without any of this.
ARG ORCA_BOX_BROWSER=1

# The Playwright browsers live outside the home folder while they are
# built: the boxes share one home volume, and a browser installed under
# it would be hidden by that volume at run time.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
ENV IMPECCABLE_BROWSER=/usr/local/bin/chromium
ENV CHROME_PATH=/usr/local/bin/chromium
ENV PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/chromium

# The user's own tools are in the home folder, which is a volume: they
# are on the PATH in every box, so a program the user installed once is
# found in every box, and not only in the one that was running when it
# was installed.
ENV PATH=/home/node/.local/bin:$PATH

RUN set -eux; \
    if [ "$ORCA_BOX_BROWSER" = "1" ]; then \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        chromium \
        libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 \
        libcups2 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3 \
        libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 \
        libxfixes3 libxkbcommon0 libxrandr2 \
        fonts-dejavu-core fonts-liberation fonts-noto-core \
        fonts-noto-color-emoji fonts-unifont fonts-wqy-zenhei \
        python3-pip; \
      rm -rf /var/lib/apt/lists/*; \
    fi

# Chromium, wrapped.
#
# The wrapper drops Chromium's own sandbox (the container is the sandbox
# here) and gives every run a profile of its own. It is named chromium,
# so it comes first on the PATH, and the browser variables point at it.
COPY chromium.sh /usr/local/bin/chromium
RUN chmod 755 /usr/local/bin/chromium

# Playwright, and the browser it drives.
#
# Both the Node and the Python package are installed, because the skills
# that drive a browser come in both kinds. The Python one is pinned to
# the version of the Node one, so both want the same browser build and
# only one copy of it is downloaded.
RUN set -eux; \
    if [ "$ORCA_BOX_BROWSER" = "1" ]; then \
      npm install -g --ignore-scripts playwright; \
      root="$(npm root -g)"; \
      version="$(node -p "require('$root/playwright/package.json').version")"; \
      pip3 install --break-system-packages "playwright==$version" \
        || pip3 install --break-system-packages playwright; \
      playwright install chromium; \
      python3 -m playwright install chromium; \
      rm -rf /var/lib/apt/lists/* /root/.cache; \
    fi

# The agents look for the browsers in the home folder, which is a
# volume: a browser an agent installs there survives the box being
# thrown away and made again. The browsers the image brought along are
# linked in there when the box starts, so both are found.
ENV PLAYWRIGHT_BROWSERS_PATH=/home/node/.cache/ms-playwright

ENV DISABLE_AUTOUPDATER=1

# The node image's "node" user is UID 1000; orca-box maps your host user onto it.
USER node
WORKDIR /home/node
