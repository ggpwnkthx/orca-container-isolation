#!/usr/bin/env bash
# tests/mocks/podman — a fake container engine for the test suite.
#
# It logs every invocation (so a test can assert on the exact commands the
# script would run) and answers the few queries the script makes.
#
# Environment:
#   FAKE_LOG        file to append the command log to
#   FAKE_EXISTING   1 (default) if a box already exists, 0 if not
#   FAKE_GIT        the git mode of the existing box (ro/rw)
LOG="${FAKE_LOG:-/tmp/fake-podman.log}"
echo "PODMAN $*" >> "$LOG"

case "$1" in
  info)
    # podman info --format '{{json .SecurityOptions}}'
    if [ "${2:-}" = "--format" ]; then echo '["name=seccomp,profile=builtin"]'; fi
    exit 0 ;;
  version)
    echo "4.9.4" ;;
  ps)
    # ps -aq --filter ... : the ids of matching containers
    [ "${FAKE_EXISTING:-1}" = 1 ] && echo "deadbeef"
    exit 0 ;;
  inspect)
    # inspect -f FORMAT NAME
    fmt=""
    while [ $# -gt 0 ]; do
      case "$1" in -f) fmt="$2"; shift ;; esac
      shift
    done
    case "$fmt" in
      *orca.worktree*) echo "/tmp" ;;
      *State.Running*) [ "${FAKE_EXISTING:-1}" = 1 ] && echo "true 2 ${FAKE_GIT:-ro}" || echo "" ;;
      *Name*) echo "/name" ;;
      *) echo "" ;;
    esac ;;
  *) exit 0 ;;
esac
